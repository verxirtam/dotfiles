#.tmux-session
#ログ取得
pipe-pane -o '/bin/sh -c "while read -r LINE; do echo \"[\$(date +\"%%Y_%%m%%d_%%H%%M%%S_%%N\")] \${LINE}\" >> \${HOME}/.tmux/log/\$(date +%Y%m%d-%H%M%S)-#S-#I.#P.log; done "'

# ホスト固有の設定
# hosts/<hostname>/tmux.session が存在すればそれを読み込む(-q: 無ければ無視)
# 古い tmux は source-file の -F (フォーマット展開) 未対応のため、
# シェル側でホスト名を展開してから source-file を呼び出す
run-shell 'tmux source-file -q "$DOTFILES_DIR/hosts/$(uname -n)/tmux.session"'


